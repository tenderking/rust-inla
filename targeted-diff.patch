-          }
-        }
+    br <- seq(min(x[ok]), max(x[ok]), length.out = n + 1L)
+  }
+  if (length(br) < 3L) {
+    return(rep(1L, length(x)))
+  }
+  as.integer(cut(x, breaks = br, include.lowest = TRUE, labels = FALSE))
+}
