+        let typ = effect_types[ei].to_lowercase();
+        if typ == "besag" {
+            let sub: List = item.try_into().map_err(|e| {
+                Error::Other(format!("adj_lists[{ei}] must be a list of integer vectors: {e}"))
+            })?;
