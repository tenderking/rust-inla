+        .collect();
+    let effect_scales_b: Vec<bool> = effect_scales.iter().map(|&v| v != 0).collect();
+    let effect_theta_lens_u: Vec<usize> = effect_theta_lens
+        .iter()
+        .map(|&v| usize::try_from(v).unwrap_or(0))
+        .collect();
+    let effect_orders_u: Vec<usize> = effect_orders
+        .iter()
+        .map(|&v| usize::try_from(v).unwrap_or(0))
