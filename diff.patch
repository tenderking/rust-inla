-pub struct DicResult {
-    /// The DIC value: D̄ + p_D
-    pub dic: f64,
-    /// Posterior mean deviance: D̄ = Σ_k w_k D(θ_k)
-    pub mean_deviance: f64,
-    /// Effective number of parameters: p_D = D̄ − D(θ*)
-    pub effective_params: f64,
-}
