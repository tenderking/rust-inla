-        if a[max_row * cols + i].abs() < 1e-14 {
-            return Err("Singular Hessian matrix".to_string());
-        }
-        if max_row != i {
-            for c in 0..cols {
-                a.swap(i * cols + c, max_row * cols + c);
-            }
-        }
-
-        let piv = a[i * cols + i];
-        for c in 0..cols {
-            a[i * cols + c] /= piv;
-        }
-
-        for r in 0..m {
-            if r == i {
-                continue;
-            }
-            let factor = a[r * cols + i];
-            if factor == 0.0 {
-                continue;
-            }
-            for c in 0..cols {
-                a[r * cols + c] -= factor * a[i * cols + c];
-            }
-        }
-    }
-
-    let mut inv = vec![0.0; m * m];
-    for i in 0..m {
-        for j in 0..m {
-            inv[i * m + j] = a[i * cols + m + j];
-        }
-    }
