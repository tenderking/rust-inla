-                grad: 0.4,
-                hess: -1.2,
-            };
-            4
-        ];
-        let (step, factor) = laplace_newton_step(&q, &evals).expect("step");
-        assert_eq!(step.len(), 4);
-        assert_eq!(factor.n, 4);
-        assert!(step.iter().all(|v| v.is_finite()));
