+    a_ncol: i32,
+    effect_types: Vec<String>,
+    effect_ns: Vec<i32>,
+    effect_scales: Vec<i32>,
+    effect_theta_lens: Vec<i32>,
+    effect_orders: Vec<i32>,
+    adj_lists: List,
+    fixed_prec: f64,
+    exposure: Vec<f64>,
+    ntrials: Vec<f64>,
+    event: Vec<f64>,
+    size: f64,
+    zero_prob: f64,
+    inflation: &str,
+    alpha: f64,
+    gamma: f64,
+    shape: f64,
