-        n_vertices += 1;
-        xmin = xmin.min(x);
-        xmax = xmax.max(x);
-        ymin = ymin.min(y);
-        ymax = ymax.max(y);
-    }
-
-    if n_vertices == 0 {
-        return Err("mesh file did not contain any parseable 'x y' vertex lines".to_string());
-    }
