+    if initial_theta.len() != expected_theta {
+        return Err(Error::Other(format!(
+            "initial_theta length {} != sum(effect_theta_lens) {}",
+            initial_theta.len(),
+            expected_theta
+        )));
+    }
+    let n_lat_expected: usize = effect_ns_u.iter().sum();
