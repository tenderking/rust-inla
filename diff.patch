+    if values.len() == 1 {
+        return vec![values[0]; n];
+    }
+    if values.len() == n {
+        return values.to_vec();
+    }
+    // Truncate or pad with last/default so callers can pass partial vectors safely.
+    let mut out = vec![default; n];
+    let m = values.len().min(n);
+    out[..m].copy_from_slice(&values[..m]);
+    out
